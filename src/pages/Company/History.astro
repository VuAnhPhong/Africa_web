---
import CompanyLayout from "../../layouts/CompanyLayout.astro";
---
<CompanyLayout title="Lịch Sử Hình Thành — VANDAMAFRICA LOGISTICS" currentPage="History">
<!-- Subpage Hero -->
<section class="subpage-hero">
    <div class="hero-inner">
        <h1 data-i18n="page_history_title">Lịch Sử Hình Thành</h1>
        <div class="subpage-breadcrumbs">
            <a href="/Company" data-i18n="bc_home">Trang chủ</a>
            <span>/</span>
            <a href="/Company/About" data-i18n="bc_intro">Giới thiệu</a>
            <span>/</span>
            <span style="color: #ffffff;" data-i18n="page_history_title">Lịch sử hình thành</span>
        </div>
    </div>
</section>

<!-- History Detailed Timeline -->
<section class="uni-section" style="background: #ffffff;">
    <div class="section-container">
        <div class="section-title-wrap text-center" style="text-align: center; max-width: 800px; margin: 0 auto 60px;">
            <span class="section-subtitle" data-i18n="history_journey_subtitle">Chặng đường hơn một thập kỷ</span>
            <h2 class="section-title" data-i18n="history_journey_title">Hành Trình Bứt Phá Vươn Ra Biển Lớn</h2>
            <p class="section-desc" style="margin: 12px auto;" data-i18n="history_journey_desc">
                Từng mốc son đánh dấu sự trưởng thành, kiên định và không ngừng đổi mới của tập thể cán bộ nhân viên VANDAMAFRICA.
            </p>
        </div>

        <div style="position: relative; max-width: 900px; margin: 0 auto; padding-left: 40px; border-left: 3px solid var(--uni-orange);">
            <!-- 2026 -->
            <div style="position: relative; margin-bottom: 50px;">
                <div style="position: absolute; left: -53px; top: 0; width: 24px; height: 24px; border-radius: 50%; background: var(--uni-orange); border: 4px solid #ffffff; box-shadow: 0 0 10px rgba(247,148,32,0.6);"></div>
                <div style="background: var(--uni-bg-light); border: 1px solid var(--uni-border); border-radius: 16px; padding: 30px; box-shadow: var(--uni-card-shadow);">
                    <span style="background: var(--uni-orange); color: #fff; font-size: 0.85rem; font-weight: 800; padding: 4px 14px; border-radius: 20px; display: inline-block; margin-bottom: 12px;" data-i18n="hist_year_2026">Năm 2026</span>
                    <h3 style="font-size: 1.4rem; font-weight: 800; color: var(--uni-navy); margin-bottom: 10px;" data-i18n="hist_title_2026">Chuyển Đổi Số Toàn Diện & Đột Phá Xuất Khẩu Sang Châu Phi & Trung Đông</h3>
                    <p style="color: var(--uni-text-muted); line-height: 1.7;" data-i18n="hist_desc_2026">
                        Triển khai nền tảng ERP Cloud quản trị kho vận thông minh và theo dõi container thời gian thực. Đạt kim ngạch xuất khẩu nông sản kỷ lục, mở rộng mạng lưới phân phối trực tiếp tại các quốc gia Châu Phi và thị trường Trung Đông.
                    </p>
                </div>
            </div>

            <!-- 2024 -->
            <div style="position: relative; margin-bottom: 50px;">
                <div style="position: absolute; left: -53px; top: 0; width: 24px; height: 24px; border-radius: 50%; background: var(--uni-navy); border: 4px solid #ffffff;"></div>
                <div style="background: var(--uni-bg-light); border: 1px solid var(--uni-border); border-radius: 16px; padding: 30px; box-shadow: var(--uni-card-shadow);">
                    <span style="background: var(--uni-navy); color: #fff; font-size: 0.85rem; font-weight: 800; padding: 4px 14px; border-radius: 20px; display: inline-block; margin-bottom: 12px;" data-i18n="hist_year_2024">Năm 2024</span>
                    <h3 style="font-size: 1.4rem; font-weight: 800; color: var(--uni-navy); margin-bottom: 10px;" data-i18n="hist_title_2024">Khánh Thành Kho Ngoại Quan KCN Nam Tân Uyên & Tăng Đội Xe Đầu Kéo</h3>
                    <p style="color: var(--uni-text-muted); line-height: 1.7;" data-i18n="hist_desc_2024">
                        Đưa vào hoạt động cụm kho ngoại quan số 3 với diện tích hơn 30.000m² tại Bình Dương, trang bị giá kệ thông minh Selective Racking và hệ thống làm mát tiêu chuẩn quốc tế cho nông sản và đồ gia dụng.
                    </p>
                </div>
            </div>

            <!-- 2022 -->
            <div style="position: relative; margin-bottom: 50px;">
                <div style="position: absolute; left: -53px; top: 0; width: 24px; height: 24px; border-radius: 50%; background: var(--uni-navy); border: 4px solid #ffffff;"></div>
                <div style="background: var(--uni-bg-light); border: 1px solid var(--uni-border); border-radius: 16px; padding: 30px; box-shadow: var(--uni-card-shadow);">
                    <span style="background: var(--uni-navy); color: #fff; font-size: 0.85rem; font-weight: 800; padding: 4px 14px; border-radius: 20px; display: inline-block; margin-bottom: 12px;" data-i18n="hist_year_2022">Năm 2022</span>
                    <h3 style="font-size: 1.4rem; font-weight: 800; color: var(--uni-navy); margin-bottom: 10px;" data-i18n="hist_title_2022">Thành Lập Chi Nhánh TP.HCM & Hải Phòng</h3>
                    <p style="color: var(--uni-text-muted); line-height: 1.7;" data-i18n="hist_desc_2022">
                        Mở rộng văn phòng tại các cảng biển huyết mạch Cát Lái, Cảng Sài Gòn và Cảng Hải Phòng. Tối ưu hóa chuỗi dịch vụ khai báo hải quan tại chỗ và dịch vụ trucking kết nối nhà máy — cảng biển.
                    </p>
                </div>
            </div>

            <!-- 2020 -->
            <div style="position: relative; margin-bottom: 50px;">
                <div style="position: absolute; left: -53px; top: 0; width: 24px; height: 24px; border-radius: 50%; background: var(--uni-navy); border: 4px solid #ffffff;"></div>
                <div style="background: var(--uni-bg-light); border: 1px solid var(--uni-border); border-radius: 16px; padding: 30px; box-shadow: var(--uni-card-shadow);">
                    <span style="background: var(--uni-navy); color: #fff; font-size: 0.85rem; font-weight: 800; padding: 4px 14px; border-radius: 20px; display: inline-block; margin-bottom: 12px;" data-i18n="hist_year_2020">Năm 2020</span>
                    <h3 style="font-size: 1.4rem; font-weight: 800; color: var(--uni-navy); margin-bottom: 10px;" data-i18n="hist_title_2020">Đại Lý Thủ Tục Hải Quan 3PL Được Công Nhận</h3>
                    <p style="color: var(--uni-text-muted); line-height: 1.7;" data-i18n="hist_desc_2020">
                        Chính thức được Cục Hải Quan công nhận là Đại lý làm thủ tục hải quan hợp chuẩn, đại diện cho hàng trăm doanh nghiệp thực hiện thông quan hàng triệu tấn hàng xuất nhập khẩu thuận lợi.
                    </p>
                </div>
            </div>

            <!-- 2018 -->
            <div style="position: relative; margin-bottom: 50px;">
                <div style="position: absolute; left: -53px; top: 0; width: 24px; height: 24px; border-radius: 50%; background: var(--uni-navy); border: 4px solid #ffffff;"></div>
                <div style="background: var(--uni-bg-light); border: 1px solid var(--uni-border); border-radius: 16px; padding: 30px; box-shadow: var(--uni-card-shadow);">
                    <span style="background: var(--uni-navy); color: #fff; font-size: 0.85rem; font-weight: 800; padding: 4px 14px; border-radius: 20px; display: inline-block; margin-bottom: 12px;" data-i18n="hist_year_2018">Năm 2018</span>
                    <h3 style="font-size: 1.4rem; font-weight: 800; color: var(--uni-navy); margin-bottom: 10px;" data-i18n="hist_title_2018">Tiên Phong Xuất Khẩu Cà Phê Lâm Đồng</h3>
                    <p style="color: var(--uni-text-muted); line-height: 1.7;" data-i18n="hist_desc_2018">
                        Thiết lập vùng nguyên liệu cà phê sạch tại Bảo Lộc — Di Linh, xây dựng chuỗi chế biến và đóng gói cà phê đạt chứng nhận quốc tế, mở đường cho những lô hàng xuất khẩu chính ngạch đầu tiên.
                    </p>
                </div>
            </div>

            <!-- 2015 -->
            <div style="position: relative;">
                <div style="position: absolute; left: -53px; top: 0; width: 24px; height: 24px; border-radius: 50%; background: var(--uni-navy); border: 4px solid #ffffff;"></div>
                <div style="background: var(--uni-bg-light); border: 1px solid var(--uni-border); border-radius: 16px; padding: 30px; box-shadow: var(--uni-card-shadow);">
                    <span style="background: var(--uni-navy); color: #fff; font-size: 0.85rem; font-weight: 800; padding: 4px 14px; border-radius: 20px; display: inline-block; margin-bottom: 12px;" data-i18n="hist_year_2015">Năm 2015</span>
                    <h3 style="font-size: 1.4rem; font-weight: 800; color: var(--uni-navy); margin-bottom: 10px;" data-i18n="hist_title_2015">Thành Lập VANDAMAFRICA</h3>
                    <p style="color: var(--uni-text-muted); line-height: 1.7;" data-i18n="hist_desc_2015">
                        CÔNG TY TNHH XUẤT NHẬP KHẨU VANDAMAFRICA chính thức đi vào hoạt động, đặt nền móng cho khát vọng xây dựng một thương hiệu xuất nhập khẩu và logistics uy tín hàng đầu khu vực.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>


</CompanyLayout>
